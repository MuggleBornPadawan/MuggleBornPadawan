{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "hermes3:3b": {
          "name": "Hermes 3 3B"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B"
        }
      }
    },
    "opencode": {
      "whitelist": [
        "big-pickle",
        "ling-3.0-flash-fin-free",
        "mimo-v2.6-flash-free",
        "muse-spark-1.3-contributor-free",
        "nemotron-3-ultra-free",
        "nemotron-3.5-lightning-free",
        "space-bunny-free"
      ]
    }
  },
  "instructions": [
    "~/.pi/agent/prompts/changelog.md",
    "~/.pi/agent/prompts/cleanup.md",
    "~/.pi/agent/prompts/docs.md",
    "~/.pi/agent/prompts/explain.md",
    "~/.pi/agent/prompts/find-bugs.md",
    "~/.pi/agent/prompts/healthcheck.md",
    "~/.pi/agent/prompts/pick-model.md",
    "~/.pi/agent/prompts/pr.md",
    "~/.pi/agent/prompts/refactor.md",
    "~/.pi/agent/prompts/simplify.md",
    "~/.pi/agent/prompts/sync-free-models.md",
    "~/.pi/agent/prompts/test.md"
  ],
  "permission": {
    "skill": {
      "dotfiles-sync": "deny",
      "wizard": "deny"
    }
  }
}

(defun square-then-double (x)
  (flet ((square (y)
           (* y y)))
    (* 2 (square x))))

(defun square-then-double-with-labels (x)
  (labels ((square (y)        
             (* y y))
           (double-squared (z)
             (* 2 (square z))))
    (double-squared x)))
(defun fun-with-optional (a &optional b)
  (format nil "The values passed: ~a and ~a.~&" a b))
(fun-with-optional 5)
(fun-with-optional 5 55)
(defun fun-with-optional-default (a &optional (b 10))
  (format nil "The values passed: ~a and ~a.~&" a b))
(fun-with-optional-default 5)
(fun-with-optional-default 5 12)
(defun fun-with-optional-predicate-check (a &optional (b 10 b-supplied-p))
  (if b-supplied-p
      (format nil "The values passed: ~a and ~a (passed by user).~&" a b)
      (format nil "The values passed: ~a and ~a (default).~&" a b)))
(defun fun-with-keys (&key a b c)
  (print b)
  (+ a b c))
(fun-with-keys :a 1 :b 2 :c 3)
(fun-with-keys :a 1 :c 2 :b 3)
(defun fun-with-keys-default (&key (a 1) (b 2) (c 3))
  (+ a b c)) 
(defun fun-with-keys-predicate (&key (a 1 a-supplied-p) (b 2 b-supplied-p) (c 3 c-supplied-p))
  (format nil "~a (~a) + ~a (~a) + ~a (~a) = ~a~&"
          a a-supplied-p
          b b-supplied-p
          c c-supplied-p
          (+ a b c)))
(fun-with-keys-predicate :a 5 :c 7)
(defun add (&rest args)
  (apply #'+ args))
(add 1 2 3 4 5)
